  <String Id="ShortcutPromptDlgDescription">Select shortcuts to create.</String>
  <String Id="ShortcutPromptDlgDesktopShortcutControlLabel">Create desktop shortcut(s)</String>
  <String Id="ShortcutPromptDlgStartMenuShortcutControlLabel">Create start menu shortcut(s)</String>

  <String Id="InstallDirNotEmptyDlg_Title">[ProductName] Setup</String>
  <String Id="InstallDirNotEmptyDlgInstallDirExistMessage">The folder [INSTALLDIR] already exist. Would you like to install to that folder anyway?</String>

  <String Id="UpgradeConfirmDlg_Title">[ProductName] [ProductVersion] Update</String>
  <String Id="UpgradeConfirmDlgTitle">{\WixUI_Font_Title}Update Existing Installation</String>
  <String Id="UpgradeConfirmDlgDescription">A previous version of [ProductName] was detected on this computer.</String>
  <String Id="UpgradeConfirmDlgMessage">Click Update to upgrade [ProductName] to version [ProductVersion].&#13;&#10;&#13;&#10;If [ProductName] is currently running in the system tray or taskbar, Setup will safely close it before updating files. Your user settings (~/.wireless-battery-java), shortcuts, and Windows startup preferences will be preserved.</String>
  <String Id="UpgradeConfirmDlgInstallDirLabel">Detected installation folder:</String>
  <String Id="UpgradeConfirmDlgUpdateButton">&amp;Update</String>

  <String Id="LaunchAppAfterInstallLabel">Launch Wireless Battery Monitor</String>

  <String Id="ContextMenuCommandLabel">Open with [ProductName]</String>

  <String Id="OsConditionMessage">[ProductName][ProductVersion] is not supported on this version of Windows</String>
